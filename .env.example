APP_NAME=Cafeteria
APP_ENV=dev
APP_PORT=8000
ALLOW_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
TRUSTED_HOSTS=["127.0.0.1","localhost"]
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=60
API_JWT_EXPIRES_MINUTES=1440
JWT_REFRESH_EXPIRES_DAYS=7
SHOP_LOGIN_SECRET=replace-with-an-independent-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cafeteria
DB_USER=
DB_PASSWORD=
RATE_ADMIN_PER_MIN=30
RATE_API_PER_MIN=60
ORDER_TAX_FEE=1.00
ORDER_DELIVERY_SERVICE_FEE=1.00
STORAGE=local
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_MB=5
ALLOWED_UPLOAD_EXTENSIONS=["jpg","jpeg","png","webp","gif","pdf"]
LOG_LEVEL=INFO
